{%- set pageTitle = (seo_title or title) -%}
{%- set pageDesc = (seo_description or excerpt or site.description) | plain -%}
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="google-site-verification" content="hYTPUD63la46O1zVJiWWDRsx_L-kBvseBzXdy8AnPdg">
  <title>{% if pageTitle and page.url != "/" %}{{ pageTitle }}｜{% endif %}{{ site.name }} {{ site.name_en }}</title>
  <meta name="description" content="{{ pageDesc }}">
  {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{% if layout == 'article.njk' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ pageTitle or site.tagline }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ cover or '/assets/img/logo.png' }}">
  <meta name="theme-color" content="#FFFAF2">
  <link rel="icon" type="image/png" href="/assets/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Huninn&family=Noto+Sans+TC:wght@300;400;500;700&family=Quicksand:wght@500;700&display=swap">
  <link rel="stylesheet" href="/assets/css/style.css">
  <script>document.documentElement.classList.add("js")</script>
</head>
<body>
  {%- import "macros.njk" as ui -%}
  <a class="skip-link" href="#main">跳到主要內容</a>

  {% if announcements.enabled and announcements.items.length %}
  <div class="topbar" data-ticker data-speed="{{ announcements.speed or 4 }}" aria-label="最新消息">
    <ul class="ticker">
      {%- for item in announcements.items %}
      <li class="ticker-item{% if loop.first %} is-active{% endif %}" data-start="{{ item.start }}" data-end="{{ item.end }}">
        <a class="topbar-inner"{% if item.link %} href="{{ item.link }}"{% if item.link.startsWith("http") %} target="_blank" rel="noopener"{% endif %}{% endif %}>
          {% if item.label %}<span class="topbar-label">{{ item.label }}</span>{% endif %}
          <span class="topbar-title">{{ item.text }}</span>
          {% if item.link %}<span class="topbar-cta">{{ item.link_text or "看看" }} <span class="arrow" aria-hidden="true">›</span></span>{% endif %}
        </a>
      </li>
      {%- endfor %}
    </ul>
  </div>
  {% endif %}

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="{{ site.name }} 首頁">
        <img src="/assets/img/logo.png" alt="{{ site.name }} Co-Dare" width="900" height="421">
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="menu-icon" aria-hidden="true"></span><span class="sr-only">選單</span>
      </button>
      <nav id="site-nav" class="site-nav" aria-label="主選單">
        {%- set navItems = [
          ["/articles/", pages.layout.nav.articles],
          ["/about/", pages.layout.nav.about],
          ["/events/", pages.layout.nav.events],
          ["/partners/", pages.layout.nav.partners],
          ["/run-with-you/", pages.layout.nav.runwith]
        ] -%}
        <ul>
          {%- for item in navItems %}
          <li><a href="{{ item[0] }}"{% if page.url and page.url.startsWith(item[0]) %} aria-current="page"{% endif %}{% if item[0] == "/run-with-you/" %} class="nav-runwith"{% endif %}>{{ item[1] }}</a></li>
          {%- endfor %}
        </ul>
        <a class="btn btn-soft btn-line" href="{{ site.line_url }}" target="_blank" rel="noopener">{{ pages.layout.nav.line_button }}</a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <svg class="footer-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0H1440V36C1200 76 960 8 720 36S240 76 0 36Z" fill="#FFFAF2"/></svg>
    <div class="container">
      <div class="footer-top">
        <div class="footer-brand">
          <span class="footer-logo"><img src="/assets/img/logo.png" alt="{{ site.name }} Co-Dare" width="900" height="421" loading="lazy"></span>
          <p class="footer-title">{{ pages.layout.footer.title }}</p>
        </div>
        <div class="footer-cols">
          <div>
            <p class="footer-head">{{ pages.layout.footer.read_head }}</p>
            <ul>
              {%- for t in topics.topics | limit(4) %}<li><a href="/topics/{{ t.slug }}/">{{ t.name }}</a></li>{% endfor %}
              <li><a href="/articles/">{{ pages.layout.footer.read_all }}</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-head">{{ pages.layout.footer.about_head }}</p>
            <ul>
              <li><a href="/about/">{{ pages.layout.footer.about_link }}</a></li>
              <li><a href="/about/#team">{{ pages.layout.footer.team_link }}</a></li>
              <li><a href="/events/">{{ pages.layout.footer.events_link }}</a></li>
              <li><a href="/partners/">{{ pages.layout.footer.partners_link }}</a></li>
              <li><a href="/partners/#collab">{{ pages.layout.footer.collab_link }}</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-head">{{ pages.layout.footer.runwith_head }}</p>
            <ul>
              <li><a href="/run-with-you/">{{ pages.layout.footer.runwith_link }}</a></li>
              <li><a href="/run-with-you/#faq">{{ pages.layout.footer.faq_link }}</a></li>
              <li><a href="{{ site.signup_url }}" target="_blank" rel="noopener">{{ pages.layout.footer.signup_link }}</a></li>
              <li><a href="{{ site.login_url }}" target="_blank" rel="noopener">{{ pages.layout.footer.login_link }}</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-head">{{ pages.layout.footer.contact_head }}</p>
            <ul>
              <li><a href="{{ site.line_url }}" target="_blank" rel="noopener">{{ pages.layout.footer.line_link }}</a></li>
              <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
              <li><a href="{{ site.social.instagram_url }}" target="_blank" rel="noopener">Instagram</a>　·　<a href="/about/#follow">Podcast</a></li>
              <li>{{ site.hours }}</li>
              <li>{{ site.method }}</li>
            </ul>
          </div>
        </div>
      </div>
      <p class="footer-note">{{ pages.article.disclaimer }}</p>
      <p class="footer-copy">© {{ year }} {{ site.name }} Co-Dare</p>
    </div>
  </footer>

  {% if page.url == "/" %}
  {%- for p in promo.items | promosFor("popup") %}
  <dialog class="promo-pop" data-promo data-promo-pop data-key="{{ p.title }}{{ p.start }}" data-start="{{ p.start }}" data-end="{{ p.end }}" aria-labelledby="promo-pop-title-{{ loop.index }}">
    <button class="promo-close" type="button" aria-label="關閉" data-promo-close>×</button>
    {% if p.image %}<img class="promo-pop-img" src="{{ p.image }}" alt="{{ p.title }}">{% endif %}
    <div class="promo-pop-body" id="promo-pop-title-{{ loop.index }}">
      {{ ui.promoBody(p, "h2") }}
    </div>
  </dialog>
  {%- endfor %}
  {% endif %}

  <a class="float-line" href="{{ site.line_url }}" target="_blank" rel="noopener" aria-label="加入官方 LINE">LINE</a>

  <script src="/assets/js/main.js" defer></script>
</body>
</html>
