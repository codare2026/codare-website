---
layout: base.njk
---
{%- import "macros.njk" as ui -%}
{%- set list = collections.articles | where("author", id) -%}
<section class="page-head">
  <div class="container profile reveal">
    <div class="profile-stage">
      {{ ui.buddy(avatar, greeting, "right") }}
    </div>
    <div class="profile-text">
      <p class="eyebrow">{{ pages.about.member.en }}</p>
      <h1>{{ name }}</h1>
      <p class="profile-role">{{ role }}{% if education %}　·　{{ education }}{% endif %}</p>
      {% if specialty %}<p class="profile-tags">{% for s in specialty.split("、") %}<span class="tag tag-soft">{{ s }}</span>{% endfor %}</p>{% endif %}
      <div class="prose">{{ content | safe }}</div>
    </div>
  </div>
</section>
<section class="section section-tight">
  <div class="container">
    {{ ui.heading("ARTICLES", name + pages.about.member.articles_suffix) }}
    {% if list.length %}
    <div class="card-grid">
      {%- for item in list %}{{ ui.articleCard(item, topics.topics, collections.team, site) }}{% endfor %}
    </div>
    {% else %}
    <p class="center muted">{{ pages.about.member.empty }}</p>
    {% endif %}
  </div>
</section>
