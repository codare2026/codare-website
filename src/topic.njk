---
layout: base.njk
pagination:
  data: topics.topics
  size: 1
  alias: topic
permalink: "/topics/{{ topic.slug }}/"
eleventyComputed:
  title: "{{ topic.name }}"
  excerpt: "{{ topic.name }}：{{ topic.desc }}。口袋營養獅營養師團隊撰寫的相關文章。"
---
{%- import "macros.njk" as ui -%}
{%- set list = collections.articles | where("topic", topic.slug) -%}
<section class="page-head">
  <div class="container">
    {{ ui.heading(pages.articles.topic_en, topic.name, topic.desc) }}
    <nav class="chips reveal" aria-label="閱讀主題">
      <a class="chip" href="/articles/">{{ pages.articles.all_chip }}</a>
      {%- for t in topics.topics %}<a class="chip" href="/topics/{{ t.slug }}/"{% if t.slug == topic.slug %} aria-current="page"{% endif %}>{{ t.name }}</a>{% endfor %}
    </nav>
  </div>
</section>
<section class="section section-tight">
  <div class="container">
    {% if list.length %}
    <div class="card-grid">
      {%- for item in list %}
      {{ ui.articleCard(item, topics.topics, collections.team, site) }}
      {%- endfor %}
    </div>
    {% else %}
    <div class="empty reveal">
      {{ ui.buddy("/assets/img/member2.png", pages.articles.empty_bubble, "left") }}
      <p><a class="btn btn-soft" href="/articles/">{{ pages.articles.empty_button }} <span class="arrow" aria-hidden="true">›</span></a></p>
    </div>
    {% endif %}
  </div>
</section>
