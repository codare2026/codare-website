---
layout: base.njk
permalink: /articles/
eleventyComputed:
  title: "{{ pages.articles.seo.title }}"
  excerpt: "{{ pages.articles.seo.description }}"
---
{%- import "macros.njk" as ui -%}
<section class="page-head">
  <div class="container">
    {{ ui.heading(pages.articles.head.en, pages.articles.head.title, pages.articles.head.sub) }}
    <nav class="chips reveal" aria-label="閱讀主題">
      <a class="chip" href="/articles/" aria-current="page">{{ pages.articles.all_chip }}</a>
      {%- for t in topics.topics %}<a class="chip" href="/topics/{{ t.slug }}/">{{ t.name }}</a>{% endfor %}
    </nav>
  </div>
</section>
<section class="section section-tight">
  <div class="container">
    <div class="card-grid">
      {%- for item in collections.articles %}
      {{ ui.articleCard(item, topics.topics, collections.team, site) }}
      {%- endfor %}
    </div>
  </div>
</section>
