---
layout: base.njk
permalink: /tools/
eleventyComputed:
  title: "{{ pages.tools.seo.title }}"
  excerpt: "{{ pages.tools.seo.description }}"
---
{%- import "macros.njk" as ui -%}
{%- set T = pages.tools -%}
{%- set F = T.form -%}
<section class="page-head">
  <div class="container">
    {{ ui.heading(T.head.en, T.head.title, T.head.sub) }}
    <div class="chips reveal" role="tablist" aria-label="選擇小工具">
      {%- for key in ["bmi", "bmr", "tdee"] %}
      <button class="chip" type="button" role="tab" id="tab-{{ key }}" data-tool="{{ key }}" aria-controls="tool-panel" aria-selected="{{ 'true' if loop.first else 'false' }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ T[key].tab }}</button>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section-tight">
  <div class="container">
    <div class="tool reveal" id="tool-panel" role="tabpanel" aria-labelledby="tab-bmi" data-tools>
      <form class="tool-form" novalidate>
        {%- for key in ["bmi", "bmr", "tdee"] %}
        <div class="tool-intro" data-for="{{ key }}"{% if not loop.first %} hidden{% endif %}>
          <h2>{{ T[key].title }}</h2>
          <p>{{ T[key].desc }}</p>
        </div>
        {%- endfor %}

        <fieldset class="field" data-for="bmr tdee" hidden>
          <legend>{{ F.sex }}</legend>
          <div class="seg">
            <label><input type="radio" name="sex" value="female" checked><span>{{ F.female }}</span></label>
            <label><input type="radio" name="sex" value="male"><span>{{ F.male }}</span></label>
          </div>
        </fieldset>
        <label class="field" data-for="bmr tdee" hidden>
          <span class="field-label">{{ F.age }}</span>
          <span class="field-input"><input type="number" name="age" inputmode="numeric" min="18" max="100" step="1" placeholder="30"><em>{{ F.age_unit }}</em></span>
        </label>
        <label class="field">
          <span class="field-label">{{ F.height }}</span>
          <span class="field-input"><input type="number" name="height" inputmode="decimal" min="100" max="250" step="0.1" placeholder="160"><em>{{ F.height_unit }}</em></span>
        </label>
        <label class="field">
          <span class="field-label">{{ F.weight }}</span>
          <span class="field-input"><input type="number" name="weight" inputmode="decimal" min="20" max="300" step="0.1" placeholder="55"><em>{{ F.weight_unit }}</em></span>
        </label>
        <fieldset class="field" data-for="tdee" hidden>
          <legend>{{ F.activity }}</legend>
          <div class="activity">
            {%- for a in T.tdee.activities %}
            <label><input type="radio" name="activity" value="{{ a.factor }}"{% if loop.first %} checked{% endif %}><span><b>{{ a.label }}</b><small>{{ a.desc }}</small></span></label>
            {%- endfor %}
          </div>
        </fieldset>
      </form>

      <div class="tool-result" aria-live="polite">
        {{ ui.buddy("/assets/img/member2.png", T.bubble, "right", "tool-buddy") }}
        <p class="result-empty" data-result="empty">{{ F.empty }}</p>
        <p class="result-empty" data-result="invalid" hidden>{{ F.invalid }}</p>

        <div data-result="bmi" hidden>
          <p class="result-label">{{ T.bmi.tab }}</p>
          <p class="result-num"><span data-out="bmi"></span></p>
          <p class="result-level"><span class="tag" data-out="level"></span></p>
          <div class="bmi-scale" aria-hidden="true">
            <span class="bmi-marker" data-out="marker"></span>
            <i style="flex: 3.5"></i><i style="flex: 5.5"></i><i style="flex: 3"></i><i style="flex: 8"></i>
          </div>
          <ol class="bmi-legend" data-levels='{{ T.bmi.levels | jsonify }}'>
            <li>{{ T.bmi.levels.under }}<small>&lt; 18.5</small></li>
            <li>{{ T.bmi.levels.normal }}<small>18.5–24</small></li>
            <li>{{ T.bmi.levels.over }}<small>24–27</small></li>
            <li>{{ T.bmi.levels.obese }}<small>≥ 27</small></li>
          </ol>
        </div>

        <div data-result="bmr" hidden>
          <p class="result-label">{{ T.bmr.tab }}</p>
          <p class="result-num"><span data-out="bmr"></span><small>{{ T.bmr.unit }}</small></p>
        </div>

        <div data-result="tdee" hidden>
          <p class="result-label">{{ T.tdee.tab }}</p>
          <p class="result-num"><span data-out="tdee"></span><small>{{ T.tdee.unit }}</small></p>
          <p class="result-sub">{{ T.tdee.bmr_label }} <b data-out="tdee-bmr"></b> {{ T.tdee.unit }}</p>
        </div>

        {%- for key in ["bmi", "bmr", "tdee"] %}
        <p class="tool-note" data-for="{{ key }}"{% if not loop.first %} hidden{% endif %}>{{ T[key].note }}</p>
        {%- endfor %}
      </div>
    </div>

    <p class="tool-disclaimer">{{ T.disclaimer }}</p>

    <div class="runwith-band reveal">
      <div class="runwith-band-text">
        <h2>{{ T.cta.title }}</h2>
        <p>{{ T.cta.text }}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/run-with-you/">{{ T.cta.button }} <span class="arrow" aria-hidden="true">›</span></a>
          <a class="btn btn-soft" href="/articles/">{{ T.cta.articles_button }}</a>
        </div>
      </div>
      {{ ui.buddy("/assets/img/member3.png", pages.home.runwith.bubble, "left") }}
    </div>
  </div>
</section>

<script src="/assets/js/tools.js" defer></script>
