---
layout: base.njk
permalink: /partners/
eleventyComputed:
  title: "{{ pages.partners.seo.title }}"
  excerpt: "{{ pages.partners.seo.description }}"
---
{%- import "macros.njk" as ui -%}
<section class="page-head">
  <div class="container">
    {{ ui.heading(pages.partners.head.en, pages.partners.head.title, pages.partners.head.sub) }}
  </div>
</section>

<section class="section section-tight">
  <div class="container">
    {% if partners.partners.length %}
    <ul class="partner-grid">
      {%- for p in partners.partners %}
      <li class="partner reveal">{% if p.url %}<a href="{{ p.url }}" target="_blank" rel="noopener">{% endif %}{% if p.logo %}<img src="{{ p.logo }}" alt="{{ p.name }}" loading="lazy">{% else %}<span>{{ p.name }}</span>{% endif %}{% if p.url %}</a>{% endif %}</li>
      {%- endfor %}
    </ul>
    {% else %}
    <p class="center muted reveal">{{ pages.partners.empty }}</p>
    {% endif %}

    {{ ui.collab(site, pages.partners.collab, "collab", '<a class="btn btn-soft" href="/events/">' + pages.partners.collab.events_button + '</a>') }}
  </div>
</section>

