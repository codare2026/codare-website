---
layout: base.njk
permalink: /about/
title: 關於我們
excerpt: 口袋營養獅由一群碩士級營養師組成，認識我們的團隊、合作夥伴與講座合作方式。
---
{%- import "macros.njk" as ui -%}
<section class="page-head">
  <div class="container">
    {{ ui.heading("ABOUT US", "關於口袋營養獅", "把專業，裝進你的口袋") }}
    <p class="about-lead reveal">{{ site.about_intro }}</p>
  </div>
</section>

<section class="section section-tight" id="team">
  <div class="container">
    {{ ui.heading("OUR TEAM", "營養師團隊") }}
    <div class="team-row">
      {%- for m in collections.team %}
      <a class="member-card reveal" href="{{ m.url }}">
        <span class="member-stage"><img class="buddy-img" src="{{ m.data.avatar }}" alt="{{ m.data.name }}插畫" loading="lazy"></span>
        <span class="member-name">{{ m.data.name }}</span>
        <span class="member-greet">{{ m.data.role }}</span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section-tight" id="follow">
  <div class="container">
    {{ ui.heading("FOLLOW US", "追蹤我們", "在 IG 和 Podcast 也找得到我們") }}
    <div class="social-grid">
      <div class="social-card reveal">
        <span class="social-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></span>
        <h3>Instagram</h3>
        <p class="social-handle">{{ site.social.instagram_handle }}</p>
        <p class="social-text">{{ site.social.instagram_text }}</p>
        <a class="btn btn-primary" href="{{ site.social.instagram_url }}" target="_blank" rel="noopener">追蹤我們的 IG <span class="arrow" aria-hidden="true">›</span></a>
      </div>
      <div class="social-card reveal">
        <span class="social-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4" height="6" rx="2"/><rect x="17" y="14" width="4" height="6" rx="2"/></svg></span>
        <h3>Podcast</h3>
        <p class="social-handle">{{ site.social.podcast_name }}</p>
        <p class="social-text">{{ site.social.podcast_text }}</p>
        <div class="btn-row">
          {%- for l in site.social.podcast_links %}
          <a class="btn btn-soft" href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a>
          {%- endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt">
  {{ ui.wave("#FDF3E4", true) }}
  <div class="container">
    {{ ui.heading("PARTNERS", "合作過的夥伴") }}
    {% if partners.partners.length %}
    <ul class="partner-grid">
      {%- for p in partners.partners %}
      <li class="partner reveal">{% if p.url %}<a href="{{ p.url }}" target="_blank" rel="noopener">{% endif %}{% if p.logo %}<img src="{{ p.logo }}" alt="{{ p.name }}" loading="lazy">{% else %}<span>{{ p.name }}</span>{% endif %}{% if p.url %}</a>{% endif %}</li>
      {%- endfor %}
    </ul>
    {% else %}
    <p class="center muted reveal">合作夥伴整理中。</p>
    {% endif %}

    {{ ui.collab(site, "collab", '<a class="btn btn-soft" href="/events/">看活動花絮</a>') }}
  </div>
  {{ ui.wave("#FFFAF2") }}
</section>

