---
layout: base.njk
permalink: /about/
eleventyComputed:
  title: "{{ pages.about.seo.title }}"
  excerpt: "{{ pages.about.seo.description }}"
---
{%- import "macros.njk" as ui -%}
<section class="page-head">
  <div class="container">
    {{ ui.heading(pages.about.head.en, pages.about.head.title, pages.about.head.sub) }}
    <p class="about-lead reveal">{{ pages.about.intro }}</p>
  </div>
</section>

<section class="section section-tight" id="team">
  <div class="container">
    {{ ui.heading(pages.about.team.en, pages.about.team.title) }}
    <div class="team-row">
      {%- for m in collections.team %}
      <a class="member-card reveal" href="{{ m.url }}">
        <span class="member-stage"><img class="buddy-img" src="{{ m.data.avatar }}" alt="{{ m.data.name }}插畫" loading="lazy"></span>
        <span class="member-name">{{ m.data.name }}</span>
        <span class="member-greet">{{ m.data.role }}</span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="follow-strip" id="follow" aria-label="{{ pages.about.follow_title }}">
  <div class="container follow-inner reveal">
    <p class="follow-title">{{ pages.about.follow_title }}</p>
    <ul class="follow-links">
      <li><a href="{{ site.social.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram {{ site.social.instagram_handle }}">
        <span class="follow-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/></svg></span>Instagram</a></li>
      {%- for l in site.social.podcast_links %}
      <li><a href="{{ l.url }}" target="_blank" rel="noopener" aria-label="{{ site.social.podcast_name }}：{{ l.label }}">
        <span class="follow-icon" aria-hidden="true">
        {%- if "spotify" in l.url -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M7.5 9.5c3-1 6.5-.7 9 .8M8 12.5c2.5-.7 5.2-.4 7.3.8M8.6 15.3c1.8-.5 3.8-.3 5.4.6"/></svg>
        {%- elif "apple" in l.url -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="10" r="3"/><path d="M12 13v7M6.3 15.5A8 8 0 1 1 17.7 15.5"/></svg>
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 10v4M8 7v10M12 4v16M16 8v8M20 11v2"/></svg>
        {%- endif -%}
        </span>{{ l.label }}</a></li>
      {%- endfor %}
    </ul>
  </div>
</section>
