---
layout: base.njk
permalink: /run-with-you/
eleventyComputed:
  title: "{{ pages.runwith.seo.title }}"
  excerpt: "{{ pages.runwith.seo.description }}"
---
{%- import "macros.njk" as ui -%}
<section class="page-head">
  <div class="container">
    {{ ui.heading(pages.runwith.head.en, pages.runwith.head.title, pages.runwith.head.sub) }}
  </div>
</section>

<section class="section section-tight">
  <div class="container runwith-grid">
    <div>
      <p class="runwith-lead reveal">{{ pages.runwith.lead | safe }}</p>
      <ol class="steps">
        {%- for s in pages.runwith.steps %}
        <li class="step reveal"><span class="step-num">{{ "0" + loop.index if loop.index < 10 else loop.index }}</span><div><h3>{{ s.title }}</h3><p>{{ s.text }}</p></div></li>
        {%- endfor %}
      </ol>
    </div>
    <aside class="contact-card reveal">
      {{ ui.buddy("/assets/img/member3.png", pages.runwith.contact.bubble, "right", "contact-buddy") }}
      <h2>{{ pages.runwith.contact.title }}</h2>
      <p>{{ pages.runwith.contact.text }}</p>
      <dl class="contact-list">
        <div><dt>LINE</dt><dd><a href="{{ site.line_url }}" target="_blank" rel="noopener">{{ site.line_id }}</a></dd></div>
        <div><dt>Email</dt><dd><a href="mailto:{{ site.email }}">{{ site.email }}</a></dd></div>
        <div><dt>時間</dt><dd>{{ site.hours }}</dd></div>
        <div><dt>方式</dt><dd>{{ site.method }}</dd></div>
      </dl>
      <a class="btn btn-primary btn-block" href="{{ site.line_url }}" target="_blank" rel="noopener">{{ pages.runwith.contact.line_button }}</a>
      <a class="btn btn-soft btn-block" href="{{ site.signup_url }}" target="_blank" rel="noopener">{{ pages.runwith.contact.signup_button }}</a>
    </aside>
  </div>
</section>

<section class="section section-alt" id="faq">
  {{ ui.wave("#FDF3E4", true) }}
  <div class="container narrow">
    {{ ui.heading(pages.runwith.faq.en, pages.runwith.faq.title) }}
    <div class="faq">
      {%- for f in pages.runwith.faq.items %}
      <details class="reveal"{% if loop.first %} open{% endif %}><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>
      {%- endfor %}
    </div>
  </div>
  {{ ui.wave("#FFFAF2") }}
</section>
