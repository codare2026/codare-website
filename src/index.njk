---
layout: base.njk
permalink: /
eleventyComputed:
  title: "{{ pages.home.seo.title }}"
  excerpt: "{{ pages.home.seo.description }}"
---
{%- import "macros.njk" as ui -%}
{%- set all = collections.articles -%}
{%- set featured = (all | findBy("featured", true)) or all[0] -%}
{%- set ft = topics.topics | findBy("slug", featured.data.topic) -%}
{%- set fa = collections.team | findBy("id", featured.data.author) -%}

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-text reveal">
      <p class="eyebrow">{{ pages.home.hero.label }}{% if ft %}　·　{{ ft.name }}{% endif %}</p>
      <h1 class="hero-title">{{ featured.data.title }}</h1>
      {% if featured.data.excerpt %}<p class="hero-lead">{{ featured.data.excerpt }}</p>{% endif %}
      <div class="btn-row">
        <a class="btn btn-primary" href="{{ featured.url }}">{{ pages.home.hero.button }} <span class="arrow" aria-hidden="true">›</span></a>
        <span class="hero-author">文／{% if fa %}{{ fa.data.name }}{% else %}{{ site.team_name }}{% endif %}</span>
      </div>
    </div>
    <div class="hero-visual reveal">
      <div class="hero-ring">
        <div class="hero-circle{% if not featured.data.cover %} is-empty{% endif %}">
          {% if featured.data.cover %}
          <img src="{{ featured.data.cover }}" alt="{{ featured.data.cover_alt }}">
          {% else %}
          <img class="hero-logo" src="/assets/img/logo.png" alt="{{ site.name }} Co-Dare" width="900" height="421">
          {% endif %}
        </div>
      </div>
      {{ ui.buddy("/assets/img/member1.png", pages.home.hero.bubble, "right", "hero-buddy") }}
      <span class="sparkle s1" aria-hidden="true"></span><span class="sparkle s2" aria-hidden="true"></span><span class="sparkle s3" aria-hidden="true"></span>
    </div>
  </div>
  {{ ui.wave("#FFFAF2") }}
</section>

{% if promo.enabled and promo.banner and promo.title %}
<section class="section section-promo" data-promo data-start="{{ promo.start }}" data-end="{{ promo.end }}" aria-label="活動宣傳">
  <div class="container">
    <div class="promo-banner reveal{% if not promo.image %} no-image{% endif %}">
      {% if promo.image %}<div class="promo-banner-img"><img src="{{ promo.image }}" alt="{{ promo.title }}" loading="lazy"></div>{% endif %}
      <div class="promo-banner-body">
        {{ ui.promoBody(promo, "h2") }}
      </div>
    </div>
  </div>
</section>
{% endif %}

<section class="section">
  <div class="container">
    {{ ui.heading(pages.home.latest.en, pages.home.latest.title, pages.home.latest.sub) }}
    <div class="card-grid">
      {%- for item in all | exclude(featured.url) | limit(3) %}
      {{ ui.articleCard(item, topics.topics, collections.team, site) }}
      {%- endfor %}
    </div>
    <p class="center"><a class="btn btn-soft" href="/articles/">{{ pages.home.latest.button }} <span class="arrow" aria-hidden="true">›</span></a></p>
  </div>
</section>

<section class="section section-alt">
  {{ ui.wave("#FDF3E4", true) }}
  <div class="container">
    {{ ui.heading(pages.home.topics.en, pages.home.topics.title, pages.home.topics.sub) }}
    <div class="topic-grid">
      {%- for t in topics.topics %}
      {%- set count = (all | where("topic", t.slug)).length %}
      <a class="topic reveal" href="/topics/{{ t.slug }}/">
        <span class="topic-ring"><span class="topic-circle topic-{{ loop.index0 % 3 }}">{{ t.name | truncate(1, true, "") }}</span></span>
        <span class="topic-name">{{ t.name }}</span>
        <span class="topic-desc">{{ t.desc }}</span>
        <span class="topic-count">{{ count }} {{ pages.home.topics.count_unit }}</span>
      </a>
      {%- endfor %}
    </div>
  </div>
  {{ ui.wave("#FFFAF2") }}
</section>

{% if collections.events.length %}
<section class="section section-alt">
  {{ ui.wave("#FDF3E4", true) }}
  <div class="container">
    {{ ui.heading(pages.home.events.en, pages.home.events.title, pages.home.events.sub) }}
    <div class="card-grid">
      {%- for e in collections.events | limit(3) %}
      <a class="card event-card reveal" href="{{ e.url }}">
        <div class="card-cover{% if not e.data.cover %} is-empty{% endif %}">{% if e.data.cover %}<img src="{{ e.data.cover }}" alt="{{ e.data.title }}" loading="lazy">{% else %}<img class="cover-mark" src="/assets/img/seal.png" alt="" loading="lazy">{% endif %}</div>
        <div class="card-body"><p class="card-meta"><span class="tag">{{ e.data.kind }}</span><time>{{ e.date | dateDot }}</time></p><h3 class="card-title">{{ e.data.title }}</h3></div>
      </a>
      {%- endfor %}
    </div>
    <p class="center"><a class="btn btn-soft" href="/events/">{{ pages.home.events.button }} <span class="arrow" aria-hidden="true">›</span></a></p>
  </div>
  {{ ui.wave("#FFFAF2") }}
</section>
{% endif %}

<section class="section">
  <div class="container">
    <div class="runwith-band reveal">
      <div class="runwith-band-text">
        <p class="eyebrow">{{ pages.home.runwith.en }}</p>
        <h2>{{ pages.home.runwith.title }}</h2>
        <p>{{ pages.runwith.lead | safe }}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/run-with-you/">{{ pages.home.runwith.button }} <span class="arrow" aria-hidden="true">›</span></a>
          <a class="btn btn-soft" href="{{ site.line_url }}" target="_blank" rel="noopener">{{ pages.home.runwith.line_button }}</a>
        </div>
      </div>
      {{ ui.buddy("/assets/img/member3.png", pages.home.runwith.bubble, "left") }}
    </div>
  </div>
</section>
